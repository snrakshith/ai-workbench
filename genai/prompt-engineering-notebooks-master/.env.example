# ══════════════════════════════════════════════════════════════
# PROVIDER SELECTION — set ONE of the three sections below.
# Leave the others blank. The notebooks auto-detect which to use.
# ══════════════════════════════════════════════════════════════

# ── Option A: OpenAI (paid, best quality) ─────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Option B: Groq (FREE, no credit card required) ────────────
# Get key: https://console.groq.com/keys  (sign up → API Keys → Create)
# Free tier: no credit card — plenty for learning
# Model used: openai/gpt-oss-120b
GROQ_API_KEY=gsk_...

# ── Option C: Gemini (FREE, no credit card required) ──────────
# Get key: https://aistudio.google.com/app/apikey  (sign in with Google)
# Free tier: generous daily quota on gemini-2.5-flash
# Model used: models/gemini-3.7-flash
GEMINI_API_KEY=AIza...

# ══════════════════════════════════════════════════════════════
# Anthropic (optional — only for XML-tag comparison examples)
# ══════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...
